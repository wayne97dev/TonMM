# ============================================================
# TonMM environment - copia in .env e compila i valori
# ============================================================

# --- Telegram bot ---
# IMPORTANTE: NON committare mai il token vero. Usa @BotFather -> /revoke se
# il token e' mai stato pubblicato in chat o repo.
TELEGRAM_BOT_TOKEN=PUT-YOUR-BOT-TOKEN-HERE
# Lista di Telegram user id autorizzati ad usare il bot (separati da virgola)
TELEGRAM_ADMIN_IDS=123456789

# --- TON network ---
# Endpoint TonCenter o TonAPI. Per produzione usa una API key.
TON_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=
# mainnet | testnet
TON_NETWORK=mainnet

# --- Master wallet (24-word mnemonic, separate da spazi) ---
# Wallet che firma tutte le tx automatiche. Va finanziato in TON e nel jetton.
MASTER_MNEMONIC="word1 word2 word3 ... word24"
# subwallet_id per Highload Wallet V3 (default 0x10ad)
HIGHLOAD_SUBWALLET_ID=4269
# Tempo di vita massimo di un external (secondi)
HIGHLOAD_TIMEOUT=128

# --- Token target del market making ---
# Indirizzo del jetton master (formato EQ... user-friendly o raw)
JETTON_MASTER=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JETTON_DECIMALS=9
JETTON_SYMBOL=MYTOKEN

# --- DEX preferito: stonfi | dedust | auto ---
DEFAULT_DEX=auto
# Indirizzo del CPI Router STON.fi v2.2 (vedi docs.ston.fi)
# Senza questo, STON.fi viene escluso dal router "auto" e i comandi che lo
# selezionano falliscono con un messaggio chiaro.
STONFI_ROUTER=

# --- Holders booster ---
# Numero di sub-wallet generati deterministicamente dal master (max 500)
HOLDERS_BOOSTER_COUNT=50
# Seed extra per derivare i sub-wallet (cambialo: e' parte del segreto)
SUBWALLETS_SEED=change-me-please

# --- Limiti di sicurezza ---
# Spesa massima in TON per singola operazione
MAX_TRADE_TON=5
# Spesa massima totale per sessione (reset al riavvio)
SESSION_BUDGET_TON=100
# Slippage massimo accettato (in %)
MAX_SLIPPAGE_PCT=2

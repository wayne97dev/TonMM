{
  "name": "tonmm",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-driven internal Market Maker for TON Chain (STON.fi + DeDust)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "ts-node --transpile-only src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@dedust/sdk": "^0.8.0",
    "@ston-fi/sdk": "^2.3.0",
    "@ton/core": "^0.62.0",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^15.1.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "grammy": "^1.30.0",
    "p-queue": "^8.0.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
